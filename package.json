{
  "name": "bstutors",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "start:backend": "npm --prefix backend run dev",
    "start:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "build": "npm --prefix frontend run build",
    "lint": "eslint .",
    "preview": "npm --prefix frontend run preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0"
  },
  "description": "BSTutors - MERN tutoring appointment booking platform",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eshaw8704/BSTutorService.git"
  },
  "keywords": [],
  "author": "Hitthenutz <matthewquan001@gmail.com>",
  "license": "ISC",
  "bugs": {
